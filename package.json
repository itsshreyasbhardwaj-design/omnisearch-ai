{
  "name": "omnisearch-ai",
  "version": "0.1.0",
  "description": "AI-native search engine for software repositories — text, regex, symbol, semantic, and hybrid search in one place",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/itsshreyasbhardwaj-design/omnisearch-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsshreyasbhardwaj-design/omnisearch-ai.git"
  },
  "bugs": {
    "url": "https://github.com/itsshreyasbhardwaj-design/omnisearch-ai/issues"
  },
  "keywords": [
    "code-search",
    "search-engine",
    "developer-tools",
    "static-analysis",
    "full-text-search",
    "regex-search",
    "code-intelligence"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "mcp": "tsx scripts/mcp-server.ts",
    "bench": "tsx scripts/bench.ts",
    "build:sdk": "pnpm --filter @omnisearch/sdk build",
    "typecheck:sdk": "pnpm --filter @omnisearch/sdk typecheck",
    "test:sdk": "pnpm --filter @omnisearch/sdk test",
    "verify": "run-s format:check lint typecheck test build typecheck:sdk test:sdk build:sdk"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-checkbox": "^1.3.9",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-dropdown-menu": "^2.1.22",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-separator": "^1.1.13",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-switch": "^1.3.5",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.14",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ignore": "^7.0.5",
    "jose": "^6.1.0",
    "lucide-react": "^1.26.0",
    "nanoid": "^6.0.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "^3.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "unzipper": "^0.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "vitest": "^4.1.10"
  }
}
